rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Primitives
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    // NOTE:
    // This app currently authenticates with Supabase, not Firebase Auth.
    // Firestore request.auth will be null in client requests.
    function isSignedIn() { return true; }
    function isAdmin() { return true; }

    // Simplified Target Validation
    function isValidTargetInit(data) {
      return data.keys().hasAll(['name', 'status', 'trustScore', 'reportCount', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0
        && data.trustScore is number
        && data.reportCount is number;
    }

    // Simplified Report Validation
    function isValidReportInit(data) {
      return data.keys().hasAll(['targetId', 'authorId', 'category', 'description', 'status', 'createdAt'])
        && data.targetId is string
        && data.authorId is string
        && data.category is string
        && data.description is string;
    }

    // Targets Collection
    match /targets/{targetId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Server APIs use Firebase Admin.
    }

    match /targetStats/{statId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /mergeAudit/{auditId} {
      allow get, list: if true;
      allow create: if false;
      allow update, delete: if false;
    }

    // Reports Collection
    match /reports/{reportId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create: if false;
      allow update, delete: if false;
    }

    // Admins Collection
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Site visit logs (written via server route + client-backed rules)
    match /visitorLogs/{logId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // IP blocks (middleware checks via REST; dashboard writes from trusted admin session)
    match /blockedIps/{blockId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }
}
